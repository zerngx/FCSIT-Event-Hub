<mxfile host="app.diagrams.net"><diagram id="Architecture" name="System Architecture"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a2" value="Presentation tier: web browser (mobile-responsive)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#333333;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1000" height="170" as="geometry"/></mxCell><mxCell id="a3" value="Application tier: Next.js on Node.js (hosted on Vercel, HTTPS)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#333333;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="0" y="270" width="1000" height="190" as="geometry"/></mxCell><mxCell id="a4" value="Data tier: Supabase (PostgreSQL 17, Singapore)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#333333;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="0" y="570" width="1000" height="190" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Student UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Browse and search events&lt;br&gt;Register&lt;br&gt;Rotating QR ticket&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20.0" y="52" width="215" height="96" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Organiser UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Create and publish events&lt;br&gt;Participants and attendance&lt;br&gt;CSV download&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="268.33333333333337" y="52" width="215" height="96" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;Check-in scanner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Phone camera (html5-qrcode)&lt;br&gt;Shows name and matric no.&lt;br&gt;Accept or reject result&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="516.6666666666667" y="52" width="215" height="96" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;Admin UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Approve organiser requests&lt;br&gt;Manage roles&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="765.0" y="52" width="215" height="96" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;Proxy (proxy.ts)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Refreshes the session cookie&lt;br&gt;Redirects signed-out visitors&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20.0" y="352" width="215" height="96" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;Pages and Server Actions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Events, registration, organiser,&lt;br&gt;admin, QR token, check-in&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="268.33333333333337" y="352" width="215" height="96" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b&gt;Route handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;attendance.csv&lt;br&gt;Formula-safe CSV export&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="516.6666666666667" y="352" width="215" height="96" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;Resume screening&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Rule-based PDF check&lt;br&gt;(iteration 2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="765.0" y="352" width="215" height="96" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Accounts and sessions (JWT)&lt;br&gt;Email and password&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20.0" y="652" width="215" height="96" as="geometry"/></mxCell><mxCell id="a14" value="&lt;b&gt;PostgreSQL with RLS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;users, events, registrations,&lt;br&gt;applications, tickets, attendance,&lt;br&gt;screening_criteria&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="268.33333333333337" y="652" width="215" height="96" as="geometry"/></mxCell><mxCell id="a15" value="&lt;b&gt;Database functions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;register_for_event, issue_qr_token,&lt;br&gt;check_in, event_attendance, seats_left&lt;br&gt;Secret and HMAC stay here&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="516.6666666666667" y="652" width="215" height="96" as="geometry"/></mxCell><mxCell id="a16" value="&lt;b&gt;File storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#444444&quot;&gt;Private resume bucket&lt;br&gt;(iteration 2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="765.0" y="652" width="215" height="96" as="geometry"/></mxCell><mxCell id="a17" value="HTTPS (all four interfaces): pages and Server Actions" style="html=1;rounded=0;startArrow=block;startFill=1;endArrow=block;endFill=1;startSize=6;endSize=6;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a6" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a18" value="Supabase client (user JWT): queries and RPC" style="html=1;rounded=0;startArrow=block;startFill=1;endArrow=block;endFill=1;startSize=6;endSize=6;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a10" target="a14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a19" value="Verify session" style="html=1;rounded=0;startArrow=block;startFill=1;endArrow=block;endFill=1;startSize=6;endSize=6;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a9" target="a13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a20" value="RPC" style="html=1;rounded=0;startArrow=block;startFill=1;endArrow=block;endFill=1;startSize=6;endSize=6;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a11" target="a15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a21" value="Security: role checks on every page and action, row-level security on every table, ticket secret unreadable from the browser, attendance written only by check_in(). Dashed boxes are planned for iteration 2." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#444444;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="780" width="1000" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>